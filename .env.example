# ============================================================
# Nyanthepa Community Radio 107.6 FM — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# In production (Vercel), set these in:
#   Vercel Dashboard → Project Settings → Environment Variables

# ----- Backend API URL -----
# Point this to wherever the FastAPI backend is hosted.
# Options:
#   - Railway:   https://your-app.up.railway.app
#   - Render:    https://your-app.onrender.com
#   - VPS:       https://api.nyanthepa.mw
#
# DO NOT set this to http://127.0.0.1:8000 in production.
# Leave blank in .env.local only if running the backend locally.
NEXT_PUBLIC_API_URL=https://ncrs-backend-ag26.onrender.com
